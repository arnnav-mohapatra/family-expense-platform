{
  "name": "family-expense-platform",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @family-expense/database generate",
    "db:validate": "pnpm exec prisma validate --schema prisma/schema.prisma",
    "db:format": "pnpm exec prisma format --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.16.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}