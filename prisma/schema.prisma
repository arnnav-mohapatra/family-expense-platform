generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  REGISTERED
  MANAGED
  GHOST
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SpaceType {
  HOUSEHOLD
  FAMILY
  TRIP
  FRIENDS
  CUSTOM
}

enum SpaceStatus {
  ACTIVE
  ARCHIVED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  LEFT
  REMOVED
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
  ITEMIZED
}

enum ExpenseStatus {
  ACTIVE
  ADJUSTED
  VOIDED
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum ExpenseAdjustmentType {
  VOID
  CORRECTION
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String? @unique
  accountType AccountType @default(REGISTERED)
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  managedById String? @db.Uuid
  managedBy User? @relation("UserManager", fields:[managedById], references:[id], onDelete:Restrict)
  manages User[] @relation("UserManager")
  memberships SpaceMember[]
  createdSpaces Space[] @relation("SpaceCreator")
  expenses Expense[] @relation("ExpenseCreator")
  payers ExpensePayer[]
  splits ExpenseSplit[]
  auditEvents AuditEvent[]
  settlementsSent Settlement[] @relation("SettlementPayer")
  settlementsReceived Settlement[] @relation("SettlementReceiver")
  createdSettlements Settlement[] @relation("SettlementCreator")
  ledgerEntries LedgerEntry[]
  expenseAdjustments ExpenseAdjustment[]
  createdRecurringExpenses RecurringExpense[] @relation("RecurringExpenseCreator")
  managedAccount ManagedAccount?
  @@index([managedById])
}

model ManagedAccount {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  managerId String @db.Uuid
  permissions Json
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  manager User @relation(fields:[managerId], references:[id], onDelete:Restrict)
  @@index([managerId])
}

model Space {
  id String @id @default(uuid()) @db.Uuid
  name String
  type SpaceType
  status SpaceStatus @default(ACTIVE)
  defaultCurrency String @db.VarChar(3)
  createdById String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation("SpaceCreator", fields:[createdById], references:[id], onDelete:Restrict)
  members SpaceMember[]
  expenses Expense[]
  settlements Settlement[]
  auditEvents AuditEvent[]
  recurringExpenses RecurringExpense[]
  expenseAdjustments ExpenseAdjustment[]
  @@index([status])
}

model SpaceMember {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  userId String @db.Uuid
  role MembershipRole @default(MEMBER)
  status MembershipStatus @default(ACTIVE)
  joinedAt DateTime @default(now())
  leftAt DateTime?
  space Space @relation(fields:[spaceId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  @@unique([spaceId,userId])
  @@index([spaceId,status])
}

model Expense {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  createdById String @db.Uuid
  description String
  expenseDate DateTime
  currency String @db.VarChar(3)
  amountMinor BigInt
  groupCurrency String @db.VarChar(3)
  groupAmountMinor BigInt
  fxRate Decimal? @db.Decimal(24,12)
  fxSource String?
  fxTimestamp DateTime?
  splitType SplitType
  status ExpenseStatus @default(ACTIVE)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  space Space @relation(fields:[spaceId], references:[id], onDelete:Restrict)
  createdBy User @relation("ExpenseCreator", fields:[createdById], references:[id], onDelete:Restrict)
  payers ExpensePayer[]
  splits ExpenseSplit[]
  items ExpenseItem[]
  ledgerEntries LedgerEntry[]
  adjustments ExpenseAdjustment[]
  settlementAllocations SettlementAllocation[]
  @@index([spaceId,expenseDate])
  @@index([spaceId,status])
}

model ExpensePayer {
  id String @id @default(uuid()) @db.Uuid
  expenseId String @db.Uuid
  userId String @db.Uuid
  amountMinor BigInt
  groupAmountMinor BigInt
  expense Expense @relation(fields:[expenseId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  @@unique([expenseId,userId])
}

model ExpenseSplit {
  id String @id @default(uuid()) @db.Uuid
  expenseId String @db.Uuid
  userId String @db.Uuid
  amountMinor BigInt
  groupAmountMinor BigInt
  splitType SplitType
  expense Expense @relation(fields:[expenseId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  @@unique([expenseId,userId])
}

model ExpenseItem {
  id String @id @default(uuid()) @db.Uuid
  expenseId String @db.Uuid
  name String
  totalMinor BigInt
  expense Expense @relation(fields:[expenseId], references:[id], onDelete:Restrict)
  assignments ExpenseItemAssignment[]
  @@index([expenseId])
}

model ExpenseItemAssignment {
  id String @id @default(uuid()) @db.Uuid
  itemId String @db.Uuid
  userId String @db.Uuid
  amountMinor BigInt
  item ExpenseItem @relation(fields:[itemId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  @@index([itemId])
}

model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  expenseId String? @db.Uuid
  settlementId String? @db.Uuid
  eventType String
  sourceId String
  accountUserId String @db.Uuid
  counterpartyUserId String? @db.Uuid
  currency String @db.VarChar(3)
  amountMinor BigInt
  direction LedgerDirection
  sequenceNumber BigInt
  createdAt DateTime @default(now())
  space Space @relation(fields:[spaceId], references:[id], onDelete:Restrict)
  expense Expense? @relation(fields:[expenseId], references:[id], onDelete:Restrict)
  settlement Settlement? @relation(fields:[settlementId], references:[id], onDelete:Restrict)
  accountUser User @relation(fields:[accountUserId], references:[id], onDelete:Restrict)
  @@unique([spaceId,sequenceNumber])
  @@index([spaceId,accountUserId])
  @@index([sourceId,eventType])
}

model Settlement {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  payerId String @db.Uuid
  receiverId String @db.Uuid
  amountMinor BigInt
  currency String @db.VarChar(3)
  method String
  status SettlementStatus @default(PENDING)
  createdById String @db.Uuid
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  space Space @relation(fields:[spaceId], references:[id], onDelete:Restrict)
  payer User @relation("SettlementPayer", fields:[payerId], references:[id], onDelete:Restrict)
  receiver User @relation("SettlementReceiver", fields:[receiverId], references:[id], onDelete:Restrict)
  creator User @relation("SettlementCreator", fields:[createdById], references:[id], onDelete:Restrict)
  allocations SettlementAllocation[]
  ledgerEntries LedgerEntry[]
  @@index([spaceId,status])
}

model SettlementAllocation {
  id String @id @default(uuid()) @db.Uuid
  settlementId String @db.Uuid
  expenseId String @db.Uuid
  amountMinor BigInt
  settlement Settlement @relation(fields:[settlementId], references:[id], onDelete:Restrict)
  expense Expense @relation(fields:[expenseId], references:[id], onDelete:Restrict)
  @@unique([settlementId,expenseId])
  @@index([expenseId])
}

model ExpenseAdjustment {
  id String @id @default(uuid()) @db.Uuid
  expenseId String @db.Uuid
  spaceId String @db.Uuid
  createdById String @db.Uuid
  type ExpenseAdjustmentType
  reason String
  createdAt DateTime @default(now())
  expense Expense @relation(fields:[expenseId], references:[id], onDelete:Restrict)
  space Space @relation(fields:[spaceId], references:[id], onDelete:Restrict)
  createdBy User @relation(fields:[createdById], references:[id], onDelete:Restrict)
  @@index([expenseId,createdAt])
  @@index([spaceId,createdAt])
}

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  actorUserId String @db.Uuid
  action String
  entityType String
  entityId String
  previousVersion Int?
  newVersion Int?
  metadata Json
  createdAt DateTime @default(now())
  space Space @relation(fields:[spaceId], references:[id], onDelete:Restrict)
  actor User @relation(fields:[actorUserId], references:[id], onDelete:Restrict)
  @@index([spaceId,createdAt])
  @@index([entityType,entityId])
}

model RecurringExpense {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  createdById String @db.Uuid
  description String
  amountMinor BigInt
  currency String @db.VarChar(3)
  recurrenceRule String
  frequency RecurrenceFrequency
  interval Int @default(1)
  payerId String @db.Uuid
  splitConfig Json
  nextOccurrence DateTime
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  space Space @relation(fields:[spaceId], references:[id], onDelete:Restrict)
  createdBy User @relation("RecurringExpenseCreator", fields:[createdById], references:[id], onDelete:Restrict)
  payer User @relation(fields:[payerId], references:[id], onDelete:Restrict)
  @@index([spaceId,active,nextOccurrence])
}

model IdempotencyKey {
  id String @id @default(uuid()) @db.Uuid
  scope String
  key String
  requestHash String
  response Json?
  statusCode Int?
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@unique([scope,key])
}
